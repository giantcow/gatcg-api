{
  "name": "gatcg-api",
  "version": "0.0.0",
  "description": "Reverse engineered model for the Grand Archive TCG API",
  "main": "index.js",
  "scripts": {
    "build:fetch": "openapi-generator-cli generate -i spec.yml -g typescript-fetch -o ./client/generated/fetch",
    "build:axios": "openapi-generator-cli generate -i spec.yml -g typescript-axios -o ./client/generated/axios",
    "build:node": "openapi-generator-cli generate -i spec.yml -g typescript-node -o ./client/generated/node",
    "build": "concurrently 'npm:build:fetch' 'npm:build:axios' 'npm:build:node'"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/giantcow/gatcg-api.git"
  },
  "keywords": [
    "TCG",
    "Grand Archive",
    "GATCG"
  ],
  "author": "Kayo <kayo@giantcow.dev>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/giantcow/gatcg-api/issues"
  },
  "homepage": "https://github.com/giantcow/gatcg-api#readme",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3"
  }
}
